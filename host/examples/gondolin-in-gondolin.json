{
  "arch": "aarch64",
  "distro": "alpine",
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [
      "linux-virt",
      "bash",
      "ca-certificates",
      "curl",
      "nodejs",
      "npm",
      "python3",
      "qemu-system-aarch64",
      "docker",
      "docker-cli",
      "containerd",
      "runc",
      "iptables"
    ],
    "initramfsPackages": []
