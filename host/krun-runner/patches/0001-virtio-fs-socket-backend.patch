+#[allow(clippy::missing_safety_doc)]
+#[unsafe(no_mangle)]
+#[cfg(not(any(feature = "tee", feature = "aws-nitro")))]
+pub unsafe extern "C" fn krun_add_virtiofs_socket(
+    ctx_id: u32,
+    c_tag: *const c_char,
+    socket_fd: c_int,
+) -> i32 {
+    if c_tag.is_null() || socket_fd < 0 {
+        return -libc::EINVAL;
+    }
+    let tag = match CStr::from_ptr(c_tag).to_str() {
+        Ok(tag) if !tag.is_empty() && tag.len() <= 36 => tag,
+        _ => return -libc::EINVAL,
+    };
+
+    match CTX_MAP.lock().unwrap().entry(ctx_id) {
+        Entry::Occupied(mut ctx_cfg) => {
+            ctx_cfg.get_mut().vmr.add_fs_device(FsDeviceConfig {
+                fs_id: tag.to_string(),
+                shared_dir: None,
+                semantics: PermissionSemantics::LinuxComplete,
+                shm_size: None,
+                read_only: false,
+                remote_fd: Some(socket_fd),
+                virtual_entries: Vec::new(),
+            });
+        }
+        Entry::Vacant(_) => return -libc::ENOENT,
+    }
+
+    KRUN_SUCCESS
+}
+
