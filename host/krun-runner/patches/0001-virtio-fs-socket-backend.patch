diff --git a/src/devices/src/virtio/fs/remote.rs b/src/devices/src/virtio/fs/remote.rs
new file mode 100644
index 0000000..194755b
--- /dev/null
+++ b/src/devices/src/virtio/fs/remote.rs
@@ -0,0 +1,102 @@
+//! virtio-fs requests served by an external process (`krun_add_virtiofs_socket`).
+//!
+//! Each request is forwarded as one frame over a connected stream socket and
+//! answered, in order, by one reply frame (see `include/libkrun.h`). The FUSE
+//! protocol itself is the server's business: this device only moves bytes
+//! between the descriptor chains and the socket.
+
+use std::io::{self, Read, Write};
+use std::os::fd::{FromRawFd, RawFd};
+use std::os::unix::net::UnixStream;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use super::descriptor_utils::{Reader, Writer};
+
+/// Size of a FUSE out header (`len`, `error`, `unique`).
+const OUT_HEADER: usize = 16;
+/// Largest request or reply accepted, in `bytes` (FUSE max pages plus headers).
+const MAX_FRAME: usize = 64 << 20;
+
+pub struct RemoteFs {
+    sock: UnixStream,
+    /// a failed exchange leaves the stream out of sync: fail from then on
+    broken: AtomicBool,
+}
+
+impl RemoteFs {
+    pub fn new(fd: RawFd) -> RemoteFs {
+        // SAFETY: the caller hands over ownership of a connected stream socket.
+        RemoteFs {
+            sock: unsafe { UnixStream::from_raw_fd(fd) },
+            broken: AtomicBool::new(false),
+        }
+    }
+
+    /// Forwards one request; returns the number of reply bytes written.
+    pub fn handle_message(&self, queue: usize, mut r: Reader, mut w: Writer) -> usize {
+        let mut request = vec![0u8; r.available_bytes()];
+        if let Err(e) = r.read_exact(&mut request) {
+            error!("virtio-fs remote: cannot read request: {e}");
+            return 0;
+        }
+        match self.round_trip(queue, &request, w.available_bytes()) {
+            Ok(reply) => match w.write_all(&reply) {
+                Ok(()) => reply.len(),
+                Err(e) => {
+                    error!("virtio-fs remote: cannot write reply: {e}");
+                    0
+                }
+            },
+            Err(e) => {
+                error!("virtio-fs remote: {e}");
+                // answer with ENOTCONN when the request expects a reply
+                if request.len() < 16 || w.available_bytes() < OUT_HEADER {
+                    return 0;
+                }
+                let mut header = [0u8; OUT_HEADER];
+                header[0..4].copy_from_slice(&(OUT_HEADER as u32).to_le_bytes());
+                header[4..8].copy_from_slice(&(-libc::ENOTCONN).to_le_bytes());
+                header[8..16].copy_from_slice(&request[8..16]);
+                match w.write_all(&header) {
+                    Ok(()) => OUT_HEADER,
+                    Err(_) => 0,
+                }
+            }
+        }
+    }
+
+    fn round_trip(&self, queue: usize, request: &[u8], capacity: usize) -> io::Result<Vec<u8>> {
+        if self.broken.load(Ordering::Relaxed) {
+            return Err(io::Error::from_raw_os_error(libc::ENOTCONN));
+        }
+        let result = self.exchange(queue, request, capacity);
+        if result.is_err() {
+            self.broken.store(true, Ordering::Relaxed);
+        }
+        result
+    }
+
+    fn exchange(&self, queue: usize, request: &[u8], capacity: usize) -> io::Result<Vec<u8>> {
+        if request.len() > MAX_FRAME {
+            return Err(io::Error::other("request too large"));
+        }
+        let mut sock = &self.sock;
+        let mut header = [0u8; 12];
+        header[0..4].copy_from_slice(&((8 + request.len()) as u32).to_le_bytes());
+        header[4..8].copy_from_slice(&(queue as u32).to_le_bytes());
+        header[8..12].copy_from_slice(&(capacity.min(MAX_FRAME) as u32).to_le_bytes());
+        sock.write_all(&header)?;
+        sock.write_all(request)?;
+        let mut len = [0u8; 4];
+        sock.read_exact(&mut len)?;
+        let len = u32::from_le_bytes(len) as usize;
+        if len > capacity {
+            return Err(io::Error::other(format!(
+                "reply of {len} bytes exceeds the {capacity} byte buffer"
+            )));
+        }
+        let mut reply = vec![0u8; len];
+        sock.read_exact(&mut reply)?;
+        Ok(reply)
+    }
+}
