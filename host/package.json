{
  "name": "@earendil-works/gondolin",
  "version": "0.12.0",
  "description": "Alpine Linux sandbox for running untrusted code with controlled filesystem and network access",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "gondolin": "./dist/bin/gondolin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/postbuild.ts",
    "start": "node dist/bin/gondolin.js exec",
    "dev": "node bin/gondolin.ts exec",
    "test": "node --test test/*.test.ts",
    "test:backend-parity": "node --test test/backend-parity.test.ts",
    "bash": "node bin/gondolin.ts bash",
    "gondolin": "node bin/gondolin.ts",
    "fuzz": "node fuzz/cli.ts",
    "prepublishOnly": "pnpm run build",
    "dep:check": "pnpm dlx dependency-cruiser --config .dependency-cruiser.cjs src",
    "dep:graph": "pnpm dlx dependency-cruiser --config .dependency-cruiser.cjs --output-type dot src > /tmp/gondolin-host-deps.dot"
  },
  "keywords": [
    "sandbox",
    "vm",
    "qemu",
    "alpine",
    "linux",
    "isolation",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/earendil-works/gondolin.git",
    "directory": "host"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "cbor2": "^2.3.0",
    "node-forge": "^1.4.0",
    "ssh2": "^1.17.0",
    "undici": "^6.29.0"
  },
  "optionalDependencies": {
    "@earendil-works/gondolin-krun-runner-darwin-arm64": "0.12.0",
    "@earendil-works/gondolin-krun-runner-linux-x64": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/node-forge": "1.3.14",
    "@types/ssh2": "1.15.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
