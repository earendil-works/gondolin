                            bool read_only, uint32_t semantics);
 
+/**
+ * Adds a virtio-fs device whose FUSE requests are served by an external
+ * process over a connected stream socket instead of a host directory.
+ *
+ * Every request is sent as a frame of little-endian u32 fields
+ * `len` (bytes after this field), `queue` (0: high priority, 1: requests) and
+ * `reply_capacity` (device-writable bytes of the descriptor chain), followed
+ * by the request bytes (FUSE in header and body). The server answers each
+ * frame, in order, with a u32 `len` (at most `reply_capacity`) and the reply
+ * bytes (FUSE out header and body; 0 bytes for requests without a reply,
+ * e.g. FORGET). On a socket error requests fail with ENOTCONN.
+ *
+ * Arguments:
+ *  "ctx_id"    - the configuration context ID.
+ *  "c_tag"     - tag to identify the filesystem in the guest (1-36 bytes).
+ *  "socket_fd" - connected stream socket; libkrun takes ownership of it.
+ *
+ * Returns:
+ *  Zero on success or a negative error number on failure.
+ */
+int32_t krun_add_virtiofs_socket(uint32_t ctx_id, const char *c_tag, int socket_fd);
+
 /* Send the VFKIT magic after establishing the connection,
    as required by gvproxy in vfkit mode. */
 #define NET_FLAG_VFKIT (1 << 0)
